# Copiez ce fichier en .env et remplissez vos valeurs. Ne commitez jamais .env.

# Base de données
DATABASE=postgresql
DATABASE_USERNAME=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_db_name
DATABASE_SCHEMA=your_db_schema

# JWT — générez SECRET_KEY avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret
ALGORITHM=HS256
TOKEN_EXPIRATION_MINUTES=300

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMTP — pour Gmail, utilisez un mot de passe d'application (pas votre mot de passe principal)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_smtp_app_password

# Rappels de réservation (en minutes)
MINUTE_CONFIRMATION=30
MINUTE_CANCEL=15
